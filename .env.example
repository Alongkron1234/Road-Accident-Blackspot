# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ห้าม commit)

# --- PostgreSQL ---
# container เดียว มี 2 database แยกกัน: "airflow" (metadata ของ Airflow เอง, สร้างอัตโนมัติ
# ตอน container init) และ "blackspot" (data warehouse ของโปรเจกต์, สร้างโดย scripts/init-db.sql)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
# 5433 ไม่ใช่ 5432 เริ่มต้น เพราะเครื่อง dev อาจมี Postgres โปรเจกต์อื่นจับ 5432 อยู่แล้ว
# (เจอเคสนี้จริงกับโปรเจกต์ goldforcast ตอน dev) เปลี่ยนเลขได้ถ้า 5433 ก็ชนอีก
POSTGRES_PORT=5433
WAREHOUSE_DB=blackspot

# --- Airflow ---
# 8081 ไม่ใช่ 8080 เริ่มต้น ด้วยเหตุผลเดียวกับ POSTGRES_PORT (กัน port ชนกับโปรเจกต์อื่น)
AIRFLOW_WEBSERVER_PORT=8081
# AIRFLOW_UID: รัน `id -u` บน Linux เพื่อกัน permission error บน mount volume (บน Mac ไม่ต้องสนใจ ใช้ default ได้)
AIRFLOW_UID=50000
# generate ด้วย: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# --- ARMS API (กรมทางหลวงชนบท) ---
ARMS_API_BASE_URL=
ARMS_API_KEY=

# --- EXAT API (การทางพิเศษแห่งประเทศไทย) ---
EXAT_API_BASE_URL=
EXAT_API_KEY=

# --- GitHub Pages publish ---
GITHUB_PAGES_REPO=
GITHUB_PAGES_DEPLOY_TOKEN=
